# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ---------- Supabase (required) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Email via Resend (required for lead emails) ----------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "HRIDAYA IT SOLUTIONS <hello@your-domain.com>"
EMAIL_FROM=
# Comma separated. Falls back to the admin "notifications" setting.
LEAD_NOTIFICATION_EMAILS=kaushalkumar2207@gmail.com

# ---------- AI SEO tools (paid, usage-based) ----------
# anthropic | openai
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional override, e.g. claude-sonnet-4-6 or gpt-4o-mini
AI_MODEL=

# ---------- Google PageSpeed Insights (free key) ----------
PAGESPEED_API_KEY=

# ---------- Security ----------
# Random 32+ char string used to hash IPs for rate limiting
IP_HASH_SALT=
# Random string; Vercel Cron sends it as Bearer token to /api/cron/retry-emails
CRON_SECRET=
